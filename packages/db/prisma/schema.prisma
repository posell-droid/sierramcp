// ============================================
// APPLICATIONS
// ============================================

model Application {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String
  description String?
  slug        String // Unique within tenant
  logoUrl     String? // Custom logo URL (S3 or external)

  // Template reference (null for custom)
  templateId String?              @db.Uuid
  template   ApplicationTemplate? @relation(fields: [templateId], references: [id])

  // Status
  status ApplicationStatus @default(DRAFT)

  // Tenant scoping
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Creator
  createdById String @db.Uuid
  createdBy   User   @relation("ApplicationCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  environments ApplicationEnvironment[]
  documents    ApplicationDocument[]
  tools        Tool[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("applications")
}

enum ApplicationStatus {
  DRAFT
  CONFIGURING
  ACTIVE
  DISABLED
  ERROR
}

// ============================================
// APPLICATION ENVIRONMENTS
// ============================================

model ApplicationEnvironment {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Environment type
  environment EnvironmentType
  baseUrl     String

  // Authentication type selector
  authType AuthType

  // ============================================
  // AUTH CONFIG - NON-SECRET METADATA ONLY
  // ============================================
  // This field stores PUBLIC authentication metadata. NEVER store secrets here.
  // Allowed values:
  //   - scopes: OAuth scopes (e.g., ["read", "write"])
  //   - authUrl: OAuth authorization URL
  //   - tokenUrl: OAuth token URL
  //   - headerName: Custom header name (e.g., "X-API-Key")
  //   - headerPrefix: Header value prefix (e.g., "Bearer")
  //   - queryParamName: Query parameter name for API key auth
  //   - clientId: OAuth client ID (public, not secret)
  //   - audience: OAuth audience
  //   - grantType: OAuth grant type (e.g., "client_credentials")
  // Example: { "scopes": ["read:users"], "headerName": "X-API-Key" }
  authConfig Json @default("{}")

  // ============================================
  // SECRET REFERENCE - THE ONLY PLACE SECRETS LIVE
  // ============================================
  // AWS Secrets Manager ARN containing actual credentials.
  // Secret JSON structure varies by authType:
  //   API_KEY:       { "apiKey": "sk-..." }
  //   OAUTH2:        { "clientSecret": "...", "refreshToken": "..." }
  //   BASIC:         { "username": "...", "password": "..." }
  //   BEARER:        { "token": "..." }
  //   CUSTOM_HEADER: { "headerValue": "..." }
  //   MTLS:          { "certificate": "...", "privateKey": "..." }
  // IMPORTANT: Application code must ONLY read secrets from Secrets Manager,
  // never from authConfig or any other database field.
  secretArn String?

  // ============================================
  // OAUTH CONNECTION STATUS
  // ============================================
  // For OAuth2 flows where users connect via authorization redirect
  oauthConnectedAt DateTime? // When OAuth was completed
  oauthShop        String?   // Connected shop domain (e.g., "my-store.myshopify.com")

  // Status
  isActive       Boolean   @default(true)
  lastTestedAt   DateTime?
  lastTestStatus String? // "OK" | error message | null

  // Tenant scoping (denormalized for RLS)
  tenantId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  toolExecutions ToolExecution[]
  oauthStates    OAuthState[]

  @@unique([applicationId, environment])
  @@index([tenantId])
  @@map("application_environments")
}

// ============================================
// OAUTH STATE (for OAuth2 Authorization Flow)
// ============================================
// Tracks OAuth authorization state for CSRF protection
// Used when users connect apps like Shopify via OAuth redirect flow

model OAuthState {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  // Random state token for CSRF protection
  state String @unique

  // Which environment this OAuth flow is for
  environmentId String                 @db.Uuid
  environment   ApplicationEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  // Tenant scoping
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // For Shopify: the shop subdomain (e.g., "my-store" from my-store.myshopify.com)
  // Optional since Amazon FBA doesn't require this
  shop String?

  // Provider-specific metadata (e.g., Amazon region: na/eu/fe)
  metadata Json @default("{}")

  // Security: 10 minute expiration, single-use
  expiresAt DateTime
  usedAt    DateTime? // Marked when used (single-use)

  createdAt DateTime @default(now())

  @@index([state])
  @@index([environmentId])
  @@index([tenantId])
  @@map("oauth_states")
}

enum EnvironmentType {
  PRODUCTION
  SANDBOX
  DEVELOPMENT
}

enum AuthType {
  API_KEY
  OAUTH2
  BASIC
  BEARER
  CUSTOM_HEADER
  MTLS
  NONE
}

// ============================================
// APPLICATION DOCUMENTS (for RAG)
// ============================================
// DEDUPLICATION STRATEGY:
// Documents are deduplicated by SHA-256 hash of normalized content.
// Re-uploaded identical content MUST NOT re-embed.
//
// Normalization rules before hashing:
//   1. Trim whitespace
//   2. Normalize line endings to \n
//   3. Remove BOM if present
//   4. For URLs: hash the fetched content, not the URL itself
//
// On duplicate detection:
//   - Return existing document ID
//   - Skip embedding pipeline
//   - Log for metrics (track dedup savings)
// ============================================

model ApplicationDocument {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Document source
  sourceType DocumentSourceType
  sourceUrl  String? // URL if link-based
  s3Key      String? // S3 key if uploaded
  fileName   String?
  mimeType   String?
  fileSize   Int? // bytes

  // ============================================
  // CONTENT HASH FOR DEDUPLICATION
  // ============================================
  // SHA-256 hash of normalized content (hex string, 64 chars)
  // Used to detect duplicate uploads within same application.
  // Computed AFTER fetching/uploading, BEFORE embedding.
  // If hash matches existing doc in same app, skip re-embedding.
  contentHash String? // SHA-256 hex, null until content fetched

  // Processing status
  status       DocumentProcessingStatus @default(PENDING)
  errorMessage String?

  // Processing progress (for UI feedback)
  totalChunks     Int? // Total chunks to process
  processedChunks Int? // Chunks completed so far

  // ============================================
  // SMART PROCESSING FIELDS
  // ============================================
  // Detected document type (auto-detected from content)
  detectedType String? // "openapi3", "swagger2", "postman", "graphql", "html", "markdown", "pdf"

  // Crawl configuration (for URL_CRAWL source type)
  crawlDepth   Int? // Max link depth for HTML crawling (default: 2)
  crawlPattern String? // URL pattern to follow (e.g., "/api/*", "*.html")

  // Crawl progress tracking
  pagesDiscovered Int? // Count of pages found during crawl
  pagesCrawled    Int? // Count of pages successfully processed

  // API documentation metrics
  endpointsFound Int? // Count of API endpoints extracted

  // Metadata
  title String?

  // Tenant scoping
  tenantId    String @db.Uuid
  createdById String @db.Uuid

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  // Relations
  chunks DocumentChunk[]

  // Unique constraint: same content hash within same application = duplicate
  @@unique([applicationId, contentHash])
  @@index([tenantId])
  @@index([applicationId, status])
  @@map("application_documents")
}

enum DocumentSourceType {
  URL // Single URL fetch
  URL_CRAWL // Recursive URL crawl (HTML docs)
  UPLOAD // S3 file upload
  TEXT // Direct text input
  OPENAPI_URL // OpenAPI spec URL
  POSTMAN_URL // Postman collection URL
}

enum DocumentProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// DOCUMENT CHUNKS (with embeddings)
// ============================================
// RAG RETRIEVAL CONSTRAINTS (enforced in application code):
//   - Top K: 5-8 chunks maximum per query
//   - Scope: Same applicationId only (cross-app retrieval forbidden)
//   - Token budget: Max 4000 tokens per retrieval (enforced pre-LLM)
//   - Similarity threshold: Minimum 0.7 cosine similarity
//
// These constraints are critical for:
//   - Cost control (fewer embeddings = lower Bedrock costs)
//   - Safety (no cross-application data leakage)
//   - Quality (irrelevant chunks hurt LLM performance)
// ============================================

model DocumentChunk {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  documentId String              @db.Uuid
  document   ApplicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Chunk content
  content    String @db.Text
  chunkIndex Int // Order within document
  tokenCount Int? // Token count for budget enforcement

  // Metadata
  metadata Json @default("{}") // Section headers, page numbers, etc.

  // Vector embedding (1536 dimensions for AWS Bedrock Titan)
  embedding Unsupported("vector(1536)")?

  // ============================================
  // CHUNK HASH FOR EMBEDDING CACHE
  // ============================================
  // SHA-256 hash of normalized chunk content (64 char hex string)
  // Used to skip re-embedding identical content across documents.
  // Unique per tenant to enable cross-document deduplication.
  // Normalization: trim, collapse whitespace, lowercase
  chunkHash String? @map("chunk_hash")

  // Tenant scoping (denormalized for efficient queries)
  // IMPORTANT: Queries MUST filter by both tenantId AND applicationId
  tenantId      String @db.Uuid
  applicationId String @db.Uuid

  createdAt DateTime @default(now())

  // Unique constraint for embedding cache: same hash within tenant = reuse embedding
  @@unique([tenantId, chunkHash])
  @@index([tenantId, applicationId])
  @@index([documentId])
  @@map("document_chunks")
}

// ============================================
// TOOLS
// ============================================
// DESIGN NOTE: Schema Duplication Awareness
// Current design has separate fields: inputSchema, headers, queryParams, bodyTemplate
// This is intentional for clarity but risks fragmentation.
//
// FUTURE IMPROVEMENT (when needed):
//   - inputSchema becomes the single source of truth (full JSON Schema)
//   - headers, queryParams, bodyTemplate become mapping objects that reference
//     schema paths (e.g., { "X-Request-ID": "$ref:input.requestId" })
//   - This consolidates validation and reduces duplication
//
// For now, the separate fields approach is acceptable for MVP.
// ============================================

model Tool {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // ============================================
  // DENORMALIZED FIELDS (for querying/display)
  // ============================================
  name         String // snake_case: "get_customer"
  title        String // Human readable: "Get Customer by ID"
  displayName  String // Legacy: same as title, kept for backward compat
  description  String     @db.Text // Full description for LLM
  status       ToolStatus @default(DRAFT)
  httpMethod   HttpMethod
  pathTemplate String // e.g., "/customers/{customerId}"

  // ============================================
  // VERSIONING
  // ============================================
  // Each tool can have multiple versions. Version 1 is the original.
  // When creating a new version from a published tool:
  //   1. Find latest version by (tenantId, applicationId, name)
  //   2. Create new record with version+1, parentToolId = published tool's id
  //   3. New version starts as DRAFT
  version       Int     @default(1)
  isLatest      Boolean @default(true) // Quick flag for "get latest version" queries
  parentToolId  String? @db.Uuid // Links to previous version for lineage
  parentTool    Tool?   @relation("ToolVersions", fields: [parentToolId], references: [id])
  childVersions Tool[]  @relation("ToolVersions")

  // ============================================
  // TOOLSPEC - Complete tool definition
  // ============================================
  // Stores the full ToolSpec JSON conforming to @repo/shared/toolspec
  // This is the source of truth; denormalized fields above are for queries
  spec Json @default("{}")

  // ============================================
  // SAFETY FLAGS (denormalized for quick filtering)
  // ============================================
  readOnly    Boolean @default(true) // GET operations
  destructive Boolean @default(false) // DELETE or irreversible ops
  pii         Boolean @default(false) // Handles personal data

  // ============================================
  // DOCUMENTATION SOURCES (citations)
  // ============================================
  // Array of { docId, chunkId, excerpt } linking to documentation
  sources Json @default("[]")

  // ============================================
  // TEST CASES & EXAMPLES
  // ============================================
  testCases Json @default("[]") // Embedded test case definitions
  examples  Json @default("{}") // Example request/response

  // ============================================
  // AUTH CONFIGURATION
  // ============================================
  authType   String? // oauth2, apiKey, basic, bearer, none
  authScopes Json    @default("[]") // OAuth2 scopes if applicable

  // Lifecycle timestamps
  publishedAt  DateTime?
  deprecatedAt DateTime?

  // Tenant scoping
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById String @db.Uuid
  createdBy   User   @relation("ToolCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  executions  ToolExecution[]
  testResults ToolTestResult[]

  // ============================================
  // INDEXES
  // ============================================
  // Primary query patterns:
  //   - List tools for application: (tenantId, applicationId)
  //   - Filter by status: (tenantId, applicationId, status)
  //   - Get latest version: (tenantId, applicationId, name, isLatest)
  //   - Unique version: (tenantId, applicationId, name, version)
  @@unique([tenantId, applicationId, name, version])
  @@index([tenantId, applicationId])
  @@index([tenantId, applicationId, status])
  @@index([tenantId, applicationId, name, isLatest])
  @@index([applicationId, readOnly]) // Filter by safety
  @@map("tools")
}

enum ToolStatus {
  DRAFT
  TESTED
  PUBLISHED
  DEPRECATED
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

// ============================================
// TOOL TEST RESULTS
// ============================================

model ToolTestResult {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  toolId String @db.Uuid
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  // Test execution
  input          Json // Test input
  expectedOutput Json? // Expected output (if defined)
  actualOutput   Json? // Actual response

  // Result
  success      Boolean
  errorMessage String?
  durationMs   Int

  // Environment used
  environmentId String? @db.Uuid

  // Who ran the test
  testedById String @db.Uuid

  tenantId String @db.Uuid

  createdAt DateTime @default(now())

  @@index([toolId])
  @@index([tenantId])
  @@map("tool_test_results")
}

// ============================================
// TOOL EXECUTIONS (Runtime logs)
// ============================================

model ToolExecution {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  toolId String @db.Uuid
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  environmentId String                 @db.Uuid
  environment   ApplicationEnvironment @relation(fields: [environmentId], references: [id])

  // Execution details
  input  Json
  output Json?

  // Metrics
  success        Boolean
  errorMessage   String?
  durationMs     Int
  httpStatusCode Int?

  // Context
  deploymentId String? @db.Uuid // Future: link to deployment
  sessionId    String? // MCP session ID

  tenantId String @db.Uuid

  createdAt DateTime @default(now())

  @@index([toolId, createdAt])
  @@index([tenantId, createdAt])
  @@map("tool_executions")
}
